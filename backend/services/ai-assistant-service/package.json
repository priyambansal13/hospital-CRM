{
  "name": "@mc/ai-assistant-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "mc": {
    "kind": "service",
    "port": 4415,
    "schema": "assistant",
    "control": true,
    "tenant": true,
    "route": "assistant",
    "owner": "team-ai",
    "publishes": [],
    "consumes": []
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -w -p tsconfig.build.json --preserveWatchOutput >/dev/null & node --watch-path=dist dist/main.js)",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests --dir src",
    "test:integration": "vitest run --passWithNoTests --dir test"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@mc/contracts": "workspace:^",
    "@mc/entitlements-sdk": "workspace:^",
    "@mc/nest-common": "workspace:^",
    "@mc/tenancy": "workspace:^",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-fastify": "~12.1.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
