{
  "name": "@mc/entitlements-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests --dir src"
  },
  "dependencies": {
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@mc/contracts": "workspace:^",
    "@mc/kafka": "workspace:^",
    "@mc/nest-common": "workspace:^",
    "lru-cache": "^11.2.2",
    "@mc/tenancy": "workspace:^",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
