{
  "name": "@mc/features",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "default": "./dist/plan.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mc/bff": "workspace:^",
    "@mc/auth": "workspace:^",
    "server-only": "^0.0.1",
    "@mc/ui": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": "^19.0.0"
  }
}
